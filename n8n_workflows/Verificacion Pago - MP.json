      "id": "9aa176b6-ba55-4a94-84d3-8783a2bd8a77",
      "name": "Consultar Mercado Pago",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        976,
        768
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "jDxhFA8wgr5OFcuF",
          "name": "MercadoPago API Gabi"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// 1. Obtener datos\nconst datosWebhook = $('Recibir Pedido Web').first().json;\n\n// Esperamos 'cuit_titular' del formulario web\nconst cuitIngresado = datosWebhook.body?.cuit_titular || \"0\"; \n\nconst pagosEncontrados = $input.all(); \n\n// 2. Si no hay pagos en MP, rechazamos\nif (pagosEncontrados.length === 0 || !pagosEncontrados[0].json.results || pagosEncontrados[0].json.results.length === 0) {\n  return { json: { verificado: false, motivo: \"No se encontraron pagos recientes por ese monto exacto.\" } };\n}\n\nconst listaPagos = pagosEncontrados[0].json.results;\n\n// Función Limpieza\nfunction limpiarNumeros(valor) {\n  if (!valor) return \"\";\n  return String(valor).replace(/[^0-9]/g, \"\"); \n}\n\n// 3. Lógica de Comparación por CUIT\nconst pagoValidado = listaPagos.find(pago => {\n  let cuitMP = \"\";\n  // Buscamos el CUIT en el pagador\n  if (pago.payer && pago.payer.identification) {\n    cuitMP = pago.payer.identification.number;\n  }\n  \n  const c1 = limpiarNumeros(cuitMP);\n  const c2 = limpiarNumeros(cuitIngresado);\n\n  // Validamos coincidencia (longitud minima 5 para evitar '0' vs '0')\n  if (c1.length > 5 && c1 === c2) {\n    return true;\n  }\n  return false;\n});\n\n// 4. Output\nif (pagoValidado) {\n  return { json: { \n    verificado: true, \n    pago_id: pagoValidado.id, \n    monto: pagoValidado.transaction_amount,\n    detalle: \"Pago Aprobado por CUIT\"\n  } };\n} else {\n  return { json: { \n    verificado: false, \n    motivo: \"El monto coincide, pero el CUIT del titular no corresponde.\"\n  } };\n}"
      },
