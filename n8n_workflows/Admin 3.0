{"updatedAt":"2026-03-14T22:14:27.000Z","createdAt":"2026-01-23T01:45:24.570Z","id":"ugZlf_LStj-YOFzxA7aZL","name":"Admin 3.0","active":false,"isArchived":true,"nodes":[{"parameters":{"updates":["message","callback_query"],"additionalFields":{}},"id":"8838b5cc-0eda-418a-9107-889a77558f75","name":"Telegram Trigger","type":"n8n-nodes-base.telegramTrigger","typeVersion":1,"position":[-2304,112],"webhookId":"2e518277-a8e2-41b4-94da-1b977d27c16c","credentials":{"telegramApi":{"id":"UtjC5YvS4gcqKFkQ","name":"Telegram Admin Bot"}}},{"parameters":{"jsCode":"const tg = $node[\"Telegram Trigger\"].json;\n\nconst msg = tg.message ?? tg.edited_message ?? null;\nconst cb  = tg.callback_query ?? null;\n\nconst isCb = !!cb;\n\nconst chat_id =\n  (cb?.message?.chat?.id)\n  ?? (msg?.chat?.id)\n  ?? null;\n\nconst message_id =\n  (cb?.message?.message_id)\n  ?? (msg?.message_id)\n  ?? null;\n\nreturn [{\n  json: {\n    isCb,\n    chat_id,\n    message_id,\n    cbq_id: cb?.id ?? null,\n    cb_data: cb?.data ?? null,\n\n    // por si lo necesitás\n    from_id: (cb?.from?.id ?? msg?.from?.id ?? null),\n    raw: tg,\n  }\n}];\n"},"id":"e30ca965-1d2b-4150-a781-b57c87c116b8","name":"Normalize","type":"n8n-nodes-base.code","typeVersion":2,"position":[-2080,112]},{"parameters":{"jsCode":"// Parse Action + Auth (SIN $env)\n// Entrada: el JSON que sale de \"Normalize\"\n\nconst norm = $input.first().json;\n\n// 1) AUTORIZACIÓN (hardcode)\n// Agregá más IDs si querés: [7831357810, 111111111, 222222222]\nconst ALLOWED_USER_IDS = [7831357810];\n\nconst authorized = ALLOWED_USER_IDS.includes(Number(norm.userId));\n\n// 2) PARSEO DE ACCIÓN\nlet action = \"help\";\nlet page = 0;\nlet orderId = null;\n\n// Si NO es callback (mensaje normal)\nif (!norm.isCb) {\n  const t = String(norm.text || \"\").trim();\n\n  if (t === \"/start\") action = \"list\";\n  else if (t.startsWith(\"/pedidos\")) action = \"list\";\n  else if (t.startsWith(\"/help\")) action = \"help\";\n  else action = \"help\";\n\n// Si ES callback (viene de botones inline)\n} else {\n  const d = String(norm.cbData || \"\");\n\n  if (d.startsWith(\"page|\")) {\n    action = \"list\";\n    page = parseInt(d.split(\"|\")[1] || \"0\", 10) || 0;\n\n  } else if (d.startsWith(\"view|\")) {\n    action = \"view\";\n    orderId = parseInt(d.split(\"|\")[1] || \"0\", 10) || 0;\n\n  } else if (d.startsWith(\"advance|\")) {\n    action = \"advance\";\n    orderId = parseInt(d.split(\"|\")[1] || \"0\", 10) || 0;\n\n  } else {\n    action = \"help\";\n  }\n}\n\n// Normalización defensiva\nif (!Number.isFinite(page) || page < 0) page = 0;\nif (orderId !== null && (!Number.isFinite(orderId) || orderId < 0)) orderId = 0;\n\nreturn [\n  {\n    json: {\n      ...norm,\n      authorized,\n      action,\n      page,\n      orderId,\n      limit: 5,\n      offset: page * 5,\n    },\n  },\n];\n"},"id":"9a17b51f-ccc3-45ee-baed-507ee1a5cabd","name":"Parse Action + Auth","type":"n8n-nodes-base.code","typeVersion":2,"position":[-1856,112]},{"parameters":{"conditions":{"boolean":[{"value1":"={{$json.authorized}}","value2":true}]},"options":{}},"id":"6efa0043-bda5-4bb9-a3f8-4c517832a4ac","name":"IF Authorized","type":"n8n-nodes-base.if","typeVersion":2,"position":[-1632,112]},{"parameters":{"chatId":"={{$json.chatId}}","text":"No autorizado.","additionalFields":{}},"id":"5398bb32-c299-4ddd-a68d-6e67903f3f3a","name":"Send Not Authorized","type":"n8n-nodes-base.telegram","typeVersion":1,"position":[-1424,288],"webhookId":"a36e6173-bd76-4ce2-8827-289330e1428b","credentials":{"telegramApi":{"id":"UtjC5YvS4gcqKFkQ","name":"Telegram Admin Bot"}}},{"parameters":{"conditions":{"string":[{"value1":"={{$json.action}}","operation":"equal","value2":"list"}]},"options":{}},"id":"68509a8c-4bf9-482a-b8b9-3b957ff73413","name":"IF Action List","type":"n8n-nodes-base.if","typeVersion":2,"position":[-1424,112]},{"parameters":{"chatId":"={{$json.chatId}}","text":"Bienvenido.\\n\\nUsá /pedidos para ver pedidos activos.","replyMarkup":"={\"inline_keyboard\":[[{\"text\":\"📋 Ver pedidos activos\",\"callback_data\":\"page|0\"}]]}","forceReply":{},"replyKeyboardOptions":{},"replyKeyboardRemove":{},"additionalFields":{}},"id":"205e6741-3a35-4e6b-ad3e-0b738e4f3314","name":"Send Help","type":"n8n-nodes-base.telegram","typeVersion":1,"position":[-1136,288],"webhookId":"3189dcfa-3897-4b13-9b8e-67cfd902437f","credentials":{"telegramApi":{"id":"UtjC5YvS4gcqKFkQ","name":"Telegram Admin Bot"}}},{"parameters":{"jsCode":"const in0 = $input.first().json;\nconst page = Number(in0.page || 0);\nconst limit = 5;\nconst offset = page * limit;\nreturn [{ json: { ...in0, limit, offset } }];"},"id":"47ec8baa-9e8c-461c-83d0-7a88b3437c8a","name":"Pagination","type":"n8n-nodes-base.code","typeVersion":2,"position":[-1136,112]},{"parameters":{"operation":"executeQuery","query":"SELECT \n  o.id,\n  o.nombre,\n  o.estado,\n  o.apertura,\n  o.precio_final,\n  o.id_cliente,\n  c.nombre AS cliente_nombre,\n  c.whatsapp\nFROM ordenes_trabajo o\nLEFT JOIN clientes c ON c.id = o.id_cliente\nWHERE (o.estado IS NOT NULL AND o.estado NOT IN ('Entregado','Cancelado'))\nORDER BY o.id DESC\nLIMIT {{$json.limit}} OFFSET {{$json.offset}};","options":{}},"id":"d77c4164-6bc1-48f0-a543-398fc34bb217","name":"MySQL List Orders","type":"n8n-nodes-base.mySql","typeVersion":2,"position":[-944,112],"credentials":{"mySql":{"id":"DHCqIwSsTPrl5I9i","name":"MySQL account"}}},{"parameters":{"jsCode":"// BUILD LIST (LISTA PRINCIPAL) - para /sendMessage\n// Entradas: items de MySQL List Orders + item Pagination\n\nconst all = $input.all().map(i => i.json);\n\n// pagination (si viene como item separado)\nconst pagination =\n  all.find(x => x.page !== undefined && x.limit !== undefined && x.offset !== undefined) || {\n    page: 0,\n    limit: 5,\n    offset: 0,\n  };\n\nconst page = Number(pagination.page) || 0;\n\n// orders reales\nconst orders = all.filter(x => Number.isFinite(Number(x.id)) && x.nombre);\n\n// texto\nlet text = `📋 *Pedidos activos (página ${page + 1})*\\n\\nSeleccioná un pedido:`;\n\n// teclado\nconst inline_keyboard = [];\n\nfor (const o of orders) {\n  const id = Number(o.id);\n  const cliente = o.cliente_nombre ? String(o.cliente_nombre) : \"\";\n  const estado = o.estado ? String(o.estado) : \"Sin estado\";\n  const precio = o.precio_final != null ? Number(o.precio_final) : null;\n\n  const priceTxt = (precio == null || Number.isNaN(precio)) ? \"\" : ` — $${precio.toFixed(2)}`;\n  const title = `${cliente ? cliente + \" — \" : \"\"}${estado}${priceTxt}`;\n\n  // 1 fila: título del pedido (sí o sí callback_data)\n  inline_keyboard.push([\n    { text: `#${id} — ${title}`, callback_data: `view|${id}` },\n  ]);\n\n  // 2 fila: acciones\n  inline_keyboard.push([\n    { text: \"🔎 Ver detalle\", callback_data: `view|${id}` },\n    { text: \"➡️ Avanzar\", callback_data: `advance|${id}` },\n  ]);\n}\n\n// paginación\nconst navRow = [];\nif (page > 0) navRow.push({ text: \"⬅️ Ant\", callback_data: `page|${page - 1}` });\nnavRow.push({ text: \"🔄 Actualizar\", callback_data: `page|${page}` });\nnavRow.push({ text: \"➡️ Sig\", callback_data: `page|${page + 1}` });\ninline_keyboard.push(navRow);\n\n// chat_id desde Telegram Trigger (mensaje normal)\nconst chat_id = $items(\"Telegram Trigger\")[0]?.json?.message?.chat?.id ?? null;\n\nreturn [{\n  json: {\n    chat_id,\n    text,\n    reply_markup: { inline_keyboard },\n    page,\n    count: orders.length,\n  },\n}];\n"},"id":"09b53025-8046-4a5f-8bd5-68e79bc191b4","name":"Build List","type":"n8n-nodes-base.code","typeVersion":2,"position":[-736,112]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":1},"conditions":[{"id":"ca1cedc3-b141-4a1f-b657-af7fc6184bb4","leftValue":"={{$json.isCb}}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"id":"e85d4c09-9112-401f-8aa0-1c84c05c7b79","name":"IF Is Callback","type":"n8n-nodes-base.if","typeVersion":2,"position":[-544,112]},{"parameters":{"method":"POST","url":"https://api.telegram.org/bot8340938275:AAEyTK2ZLtLIew22Bk2Dl_LMZCJtUetCg6s/sendMessage","sendBody":true,"bodyParameters":{"parameters":[{"name":"chat_id","value":"={{ \n  $json.chat_id \n  || $node[\"Telegram Trigger\"].json.callback_query?.message?.chat?.id \n  || $node[\"Telegram Trigger\"].json.message?.chat?.id \n}}"},{"name":"text","value":"={{ $items(\"Build List\")[0].json.text }}"},{"name":"parse_mode","value":"Markdown"},{"name":"reply_markup","value":"={{ $items(\"Build List\")[0].json.reply_markup }}"}]},"options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.3,"position":[-336,224],"id":"abcd5ba7-6b86-4a12-be96-757497d1b63f","name":"HTTP TG SendMessage"},{"parameters":{"method":"POST","url":"https://api.telegram.org/bot8340938275:AAEyTK2ZLtLIew22Bk2Dl_LMZCJtUetCg6s/sendMessage","sendBody":true,"bodyParameters":{"parameters":[{"name":"chat_id","value":"={{$node[\"Parse Callback\"].json.chatId}}"},{"name":"text","value":"={{$node[\"Build List\"].json.text}}"},{"name":"reply_markup","value":"={{$node[\"Build List\"].json.replyMarkupObj}}"},{"name":"message_id","value":"={{$node[\"Parse Callback\"].json.messageId}}"},{"name":"parse_mode","value":"Markdown"}]},"options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.3,"position":[688,-112],"id":"f85b1ef4-dc81-4b80-8a87-3a01fdab62e0","name":"HTTP TG EditMessageText"},{"parameters":{"method":"POST","url":"https://api.telegram.org/bot8340938275:AAEyTK2ZLtLIew22Bk2Dl_LMZCJtUetCg6s/sendMessage","sendBody":true,"bodyParameters":{"parameters":[{"name":"callback_query_id","value":"={{$json.cbq_id}}"}]},"options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.3,"position":[-176,32],"id":"1c3559a1-5838-4d5b-b22c-2ca9d91c9e1c","name":"HTTP TG AnswerCallbackQuery"},{"parameters":{"jsCode":"const isCb = !!$json.isCb;\nconst data = String($json.cb_data || \"\");\n\nconst [actionRaw, idRaw, pageRaw] = data.split(\"|\");\n\nconst action = (actionRaw || \"\").trim();\nconst id = idRaw != null && idRaw !== \"\" ? Number(idRaw) : null;\nconst page = pageRaw != null && pageRaw !== \"\" ? Number(pageRaw) : null;\n\nreturn [{\n  json: {\n    isCb,\n    action,\n    id: Number.isFinite(id) ? id : null,\n    page: Number.isFinite(page) ? page : null,\n\n    // IMPORTANTES para responder y editar\n    cbq_id: $json.cbq_id ?? null,\n    chat_id: $json.chat_id ?? null,\n    message_id: $json.message_id ?? null,\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-336,32],"id":"a97288c2-65a2-4a1f-b8dd-079556f318fc","name":"Parse Callback"},{"parameters":{"mode":"expression","numberOutputs":3,"output":"={{ \n  $json.action === 'page' ? 0 :\n  $json.action === 'advance' ? 1 :\n  2\n}}\n"},"type":"n8n-nodes-base.switch","typeVersion":3.4,"position":[0,16],"id":"8d16cdb3-6cda-4e41-b733-98912a203561","name":"Switch"},{"parameters":{"jsCode":"const page = Number($json.page ?? 0);\nconst limit = 5;\n\nreturn [\n  {\n    json: {\n      ...$json,\n      page,\n      limit,\n      offset: page * limit\n    }\n  }\n];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[208,-112],"id":"af72f60a-6f74-4516-b00a-d6df86302553","name":"page"},{"parameters":{"operation":"executeQuery","query":"LIMIT {{$json.limit}} OFFSET {{$json.offset}}","options":{}},"type":"n8n-nodes-base.mySql","typeVersion":2.5,"position":[368,-112],"id":"8aaac0e4-f838-453d-8b01-ab1bef523711","name":"Execute a SQL query","credentials":{"mySql":{"id":"DHCqIwSsTPrl5I9i","name":"MySQL account"}}},{"parameters":{"jsCode":"// BUILD LIST (PAGE) - para /editMessageText\n// Entradas: resultados del SQL de la página + (opcional) pagination\n\nconst all = $input.all().map(i => i.json);\n\nconst pagination =\n  all.find(x => x.page !== undefined && x.limit !== undefined && x.offset !== undefined) || {\n    page: 0,\n    limit: 5,\n    offset: 0,\n  };\n\nconst page = Number(pagination.page) || 0;\nconst orders = all.filter(x => Number.isFinite(Number(x.id)) && x.nombre);\n\nlet text = `📋 *Pedidos activos (página ${page + 1})*\\n\\nSeleccioná un pedido:`;\n\nconst inline_keyboard = [];\n\nfor (const o of orders) {\n  const id = Number(o.id);\n  const cliente = o.cliente_nombre ? String(o.cliente_nombre) : \"\";\n  const estado = o.estado ? String(o.estado) : \"Sin estado\";\n  const precio = o.precio_final != null ? Number(o.precio_final) : null;\n\n  const priceTxt = (precio == null || Number.isNaN(precio)) ? \"\" : ` — $${precio.toFixed(2)}`;\n  const title = `${cliente ? cliente + \" — \" : \"\"}${estado}${priceTxt}`;\n\n  inline_keyboard.push([{ text: `#${id} — ${title}`, callback_data: `view|${id}` }]);\n  inline_keyboard.push([\n    { text: \"🔎 Ver detalle\", callback_data: `view|${id}` },\n    { text: \"➡️ Avanzar\", callback_data: `advance|${id}` },\n  ]);\n}\n\nconst navRow = [];\nif (page > 0) navRow.push({ text: \"⬅️ Ant\", callback_data: `page|${page - 1}` });\nnavRow.push({ text: \"🔄 Actualizar\", callback_data: `page|${page}` });\nnavRow.push({ text: \"➡️ Sig\", callback_data: `page|${page + 1}` });\ninline_keyboard.push(navRow);\n\n// datos del callback (para editar el mismo mensaje)\nconst cb = $items(\"Parse Callback\")[0]?.json;\nconst chat_id = cb?.chatId ?? null;\nconst message_id = cb?.messageId ?? null;\n\nreturn [{\n  json: {\n    chat_id,\n    message_id,\n    text,\n    reply_markup: { inline_keyboard },\n    page,\n    count: orders.length,\n  },\n}];\n"},"id":"c4394ac2-2f67-4b18-aa12-4beaac520881","name":"Build List1","type":"n8n-nodes-base.code","typeVersion":2,"position":[528,-112]},{"parameters":{"operation":"executeQuery","query":"SELECT id, estado\nFROM ordenes_trabajo\nWHERE id = {{ $json.id }}\nLIMIT 1;\n","options":{}},"type":"n8n-nodes-base.mySql","typeVersion":2.5,"position":[208,32],"id":"30ee58e0-6f29-4021-a031-4c8c47a472c8","name":"MySQL Get Current","credentials":{"mySql":{"id":"DHCqIwSsTPrl5I9i","name":"MySQL account"}}},{"parameters":{"jsCode":"const row = $input.first().json;\n\n// Definí acá tu flujo de estados (ajustalo a tus nombres reales)\nconst flow = [\n  \"Pago Verificado\",\n  \"Producción\",\n  \"Listo\",\n  \"Entregado\",\n];\n\nconst current = String(row.estado ?? \"\").trim();\n\n// Si el estado no está en la lista, arrancamos desde el primero\nconst idx = flow.indexOf(current);\nconst next = (idx === -1)\n  ? flow[0]\n  : flow[Math.min(idx + 1, flow.length - 1)];\n\nreturn [{\n  json: {\n    id: Number(row.id),\n    current,\n    next,\n  }\n}];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[368,32],"id":"60e78b6f-9f6f-46e7-9613-51fdd10738cd","name":"Next Status"},{"parameters":{"operation":"executeQuery","query":"UPDATE ordenes_trabajo\nSET estado = '{{ $json.next }}'\nWHERE id = {{ $json.id }};\n","options":{}},"type":"n8n-nodes-base.mySql","typeVersion":2.5,"position":[528,32],"id":"01c05d57-f139-4224-8729-104c4eaa7973","name":"MySQL Update","credentials":{"mySql":{"id":"DHCqIwSsTPrl5I9i","name":"MySQL account"}}},{"parameters":{"operation":"executeQuery","query":"LIMIT {{$json.limit}} OFFSET {{$json.offset}}","options":{}},"type":"n8n-nodes-base.mySql","typeVersion":2.5,"position":[688,32],"id":"64bb018c-717d-42d0-99d4-45e1c63de395","name":"Execute a SQL query1","credentials":{"mySql":{"id":"DHCqIwSsTPrl5I9i","name":"MySQL account"}}},{"parameters":{"jsCode":"// BUILD LIST (PAGE) - para /editMessageText\n// Entradas: resultados del SQL de la página + (opcional) pagination\n\nconst all = $input.all().map(i => i.json);\n\nconst pagination =\n  all.find(x => x.page !== undefined && x.limit !== undefined && x.offset !== undefined) || {\n    page: 0,\n    limit: 5,\n    offset: 0,\n  };\n\nconst page = Number(pagination.page) || 0;\nconst orders = all.filter(x => Number.isFinite(Number(x.id)) && x.nombre);\n\nlet text = `📋 *Pedidos activos (página ${page + 1})*\\n\\nSeleccioná un pedido:`;\n\nconst inline_keyboard = [];\n\nfor (const o of orders) {\n  const id = Number(o.id);\n  const cliente = o.cliente_nombre ? String(o.cliente_nombre) : \"\";\n  const estado = o.estado ? String(o.estado) : \"Sin estado\";\n  const precio = o.precio_final != null ? Number(o.precio_final) : null;\n\n  const priceTxt = (precio == null || Number.isNaN(precio)) ? \"\" : ` — $${precio.toFixed(2)}`;\n  const title = `${cliente ? cliente + \" — \" : \"\"}${estado}${priceTxt}`;\n\n  inline_keyboard.push([{ text: `#${id} — ${title}`, callback_data: `view|${id}` }]);\n  inline_keyboard.push([\n    { text: \"🔎 Ver detalle\", callback_data: `view|${id}` },\n    { text: \"➡️ Avanzar\", callback_data: `advance|${id}` },\n  ]);\n}\n\nconst navRow = [];\nif (page > 0) navRow.push({ text: \"⬅️ Ant\", callback_data: `page|${page - 1}` });\nnavRow.push({ text: \"🔄 Actualizar\", callback_data: `page|${page}` });\nnavRow.push({ text: \"➡️ Sig\", callback_data: `page|${page + 1}` });\ninline_keyboard.push(navRow);\n\n// datos del callback (para editar el mismo mensaje)\nconst cb = $items(\"Parse Callback\")[0]?.json;\nconst chat_id = cb?.chatId ?? null;\nconst message_id = cb?.messageId ?? null;\n\nreturn [{\n  json: {\n    chat_id,\n    message_id,\n    text,\n    reply_markup: { inline_keyboard },\n    page,\n    count: orders.length,\n  },\n}];\n"},"id":"ead97a5b-be2c-45a6-be52-8e85519d568f","name":"Build List2","type":"n8n-nodes-base.code","typeVersion":2,"position":[848,32]},{"parameters":{"method":"POST","url":"https://api.telegram.org/bot8340938275:AAEyTK2ZLtLIew22Bk2Dl_LMZCJtUetCg6s/sendMessage","sendBody":true,"bodyParameters":{"parameters":[{"name":"chat_id","value":"={{ $node[\"Parse Callback\"].json.chatId }}"},{"name":"text","value":"={{ $items(\"Build List\")[0].json.text }}"},{"name":"reply_markup","value":"={{ $items(\"Build List\")[0].json.replyMarkupObj }}"},{"name":"message_id","value":"={{ $node[\"Parse Callback\"].json.messageId }}"},{"name":"parse_mode","value":"Markdown"}]},"options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.3,"position":[1008,32],"id":"66d265ef-ee45-40b2-8c89-d25c5977f610","name":"HTTP TG EditMessageText1"},{"parameters":{"method":"POST","url":"https://api.telegram.org/bot8340938275:AAEyTK2ZLtLIew22Bk2Dl_LMZCJtUetCg6s/sendMessage","sendBody":true,"bodyParameters":{"parameters":[{"name":"callback_query_id","value":"={{ $node[\"Parse Callback\"].json.cbqId }}"}]},"options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.3,"position":[1200,32],"id":"798946b5-968b-411d-ab00-397d199c129c","name":"HTTP TG AnswerCallbackQuery1"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"452d7b6e-becd-4c63-9059-4930da2cd25a","leftValue":"={{$json.action}}","rightValue":"view","operator":{"type":"string","operation":"equals","name":"filter.operator.equals"}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.3,"position":[208,176],"id":"598b2dac-6723-4bde-a2f9-a7d03fbdefb7","name":"Es View?"},{"parameters":{"method":"POST","url":"https://api.telegram.org/bot8340938275:AAEyTK2ZLtLIew22Bk2Dl_LMZCJtUetCg6s/sendMessage","sendBody":true,"bodyParameters":{"parameters":[{"name":"callback_query_id","value":"={{ $node[\"Parse Callback\"].json.cbqId }}"}]},"options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.3,"position":[368,320],"id":"4ba7f9aa-4207-4ad7-83d3-a6ae99c3dd04","name":"HTTP TG AnswerCallbackQuery2"},{"parameters":{"operation":"executeQuery","query":"SELECT\n  o.id,\n  o.nombre,\n  o.estado,\n  o.apertura,\n  o.precio_final,\n  c.nombre AS cliente_nombre,\n  c.whatsapp\nFROM ordenes_trabajo o\nLEFT JOIN clientes c ON c.id = o.id_cliente\nWHERE o.id = {{ $json.id }}\nLIMIT 1;\n","options":{}},"type":"n8n-nodes-base.mySql","typeVersion":2.5,"position":[368,176],"id":"facec307-480f-43d8-b7d3-238cded8fcef","name":"MySQL Get Detail","credentials":{"mySql":{"id":"DHCqIwSsTPrl5I9i","name":"MySQL account"}}},{"parameters":{"jsCode":"// Build Detail (Run once for all items)\n\nconst row = $input.first()?.json ?? {};\n\n// Contexto del callback (viene del Parse Callback)\nconst ctx = $node[\"Parse Callback\"].json;\n\n// Helpers\nconst fmtMoney = (n) => {\n  const num = Number(n);\n  if (!Number.isFinite(num)) return \"-\";\n  return `$${num.toFixed(2)}`;\n};\n\nconst safe = (v, fallback = \"-\") => {\n  if (v === null || v === undefined) return fallback;\n  const s = String(v).trim();\n  return s.length ? s : fallback;\n};\n\nconst id = Number(row.id ?? ctx.id);\nconst nombre = safe(row.nombre, \"Pedido\");\nconst estado = safe(row.estado, \"Sin estado\");\nconst cliente = safe(row.cliente_nombre, \"Sin cliente\");\nconst whatsapp = safe(row.whatsapp, \"-\");\nconst apertura = safe(row.apertura, \"-\");\nconst precio = fmtMoney(row.precio_final);\n\n// Texto largo (acá sí se ve completo, no en botones)\nconst text =\n`📄 *Detalle de pedido #${id}*\n👤 *Cliente:* ${cliente}\n📌 *Estado:* ${estado}\n💰 *Total:* ${precio}\n🕒 *Apertura:* ${apertura}\n📱 *WhatsApp:* ${whatsapp}\n\n_${nombre}_`;\n\n// Botones: mantenelos cortos (Telegram recorta botones en móvil)\nconst inline_keyboard = [\n  [\n    { text: \"➡️ Avanzar\", callback_data: `advance|${id}` },\n    { text: \"🔄 Actualizar\", callback_data: `view|${id}` },\n  ],\n  [\n    // Volver a la lista: si no tenemos page, volvemos a 0\n    { text: \"⬅️ Volver a lista\", callback_data: `page|${Number(ctx.page ?? 0) || 0}` },\n  ],\n];\n\n// Si querés navegación desde detalle (opcional)\ninline_keyboard.push([\n  { text: \"⬅️ Ant\", callback_data: `page|${Math.max((Number(ctx.page ?? 0) || 0) - 1, 0)}` },\n  { text: \"➡️ Sig\", callback_data: `page|${(Number(ctx.page ?? 0) || 0) + 1}` },\n]);\n\nreturn [{\n  json: {\n    text,\n    replyMarkupObj: { inline_keyboard },\n    // útil por si querés loguear\n    id,\n  }\n}];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[528,176],"id":"9386c7e3-d502-42ab-886f-f3b6667c286b","name":"Build Detail"},{"parameters":{"method":"POST","url":"https://api.telegram.org/bot8340938275:AAEyTK2ZLtLIew22Bk2Dl_LMZCJtUetCg6s/sendMessage","sendBody":true,"bodyParameters":{"parameters":[{"name":"chat_id","value":"={{$node[\"Parse Callback\"].json.chatId}}"},{"name":"text","value":"={{$node[\"Build List\"].json.text}}"},{"name":"reply_markup","value":"={{$node[\"Parse Callback\"].json.messageId}}"},{"name":"message_id","value":"={{$node[\"Parse Callback\"].json.messageId}}"},{"name":"parse_mode","value":"Markdown"}]},"options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.3,"position":[688,176],"id":"cb46055a-90e2-4c15-aa9a-9fdf871ab7f2","name":"HTTP TG EditMessageText2"},{"parameters":{"method":"POST","url":"https://api.telegram.org/bot8340938275:AAEyTK2ZLtLIew22Bk2Dl_LMZCJtUetCg6s/sendMessage","sendBody":true,"bodyParameters":{"parameters":[{"name":"callback_query_id","value":"={{ $node[\"Parse Callback\"].json.cbqId }}"},{"name":"text","value":"Detalle cargado"}]},"options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.3,"position":[848,176],"id":"32a21816-f516-4fb0-bdb7-43c03531237c","name":"HTTP TG AnswerCallbackQuery3"}],"connections":{"Telegram Trigger":{"main":[[{"node":"Normalize","type":"main","index":0}]]},"Normalize":{"main":[[{"node":"Parse Action + Auth","type":"main","index":0}]]},"Parse Action + Auth":{"main":[[{"node":"IF Authorized","type":"main","index":0}]]},"IF Authorized":{"main":[[{"node":"IF Action List","type":"main","index":0}],[{"node":"Send Not Authorized","type":"main","index":0}]]},"IF Action List":{"main":[[{"node":"Pagination","type":"main","index":0}],[{"node":"Send Help","type":"main","index":0}]]},"Pagination":{"main":[[{"node":"MySQL List Orders","type":"main","index":0}]]},"MySQL List Orders":{"main":[[{"node":"Build List","type":"main","index":0}]]},"Build List":{"main":[[{"node":"IF Is Callback","type":"main","index":0}]]},"IF Is Callback":{"main":[[{"node":"Parse Callback","type":"main","index":0}],[{"node":"HTTP TG SendMessage","type":"main","index":0}]]},"HTTP TG Answer