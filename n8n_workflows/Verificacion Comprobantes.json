cuyo","operator":{"type":"string","operation":"contains"}},{"id":"d68a71a5-f5cf-40e6-a804-d52b32968b96","leftValue":"={{ $('Code in JavaScript').item.json.cuenta_destino }}","rightValue":"3840200500000016050675","operator":{"type":"string","operation":"contains"}},{"id":"45fce31e-a995-4cef-b30e-26c1edac8202","leftValue":"={{ $('Code in JavaScript').item.json.banco_destino }}","rightValue":"Uala","operator":{"type":"string","operation":"contains"}}],"combinator":"or"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.2,"position":[-288,160],"id":"2b44524c-887a-4667-a615-46c6fdb31d6a","name":"If"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"bee6a97c-3d76-4059-b84a-c0f6c5268209","leftValue":"={{ $json.id_pedido_externo }}","rightValue":"","operator":{"type":"string","operation":"notEmpty","singleValue":true}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.2,"position":[-144,80],"id":"1977a446-ae73-4d54-9ded-6adac49c5935","name":"If1"},{"parameters":{"chatId":"={{ $('Telegram Trigger').item.json.message.from.id }}","text":"⚠️ Error de Destinatario: El comprobante enviado no parece estar dirigido a nuestra cuenta (VectorCuyo / Jorge Jose German Vazquez Jofre). Por favor verifica.","additionalFields":{"appendAttribution":false}},"type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[-144,240],"id":"64beb539-df46-403a-8e8c-29a85fdbf422","name":"Send a text message","webhookId":"f3482f27-02fa-4930-994c-ac68eed70428","credentials":{"telegramApi":{"id":"AGndVGFeG84kWihj","name":"Telegram account"}}},{"parameters":{"chatId":"={{ $('Telegram Trigger').item.json.message.from.id }}","text":"=💰 Pago Recibido: Vemos tu transferencia de {{ $('Code in JavaScript').item.json.monto }}, pero no encontramos una orden pendiente por ese monto exacto.\n\nSi es un pago parcial, por favor espera a la verificacion personal.\n\nSi es el total, verifica si env