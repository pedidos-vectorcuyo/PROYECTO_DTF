{
    "name": "B2B Order Handler",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "b2b-order",
                "responseMode": "onReceived",
                "options": {}
            },
            "id": "webhook-b2b",
            "name": "Webhook - Nueva Orden",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                250,
                300
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "string": [
                        {
                            "value1": "={{ $json.body.token_receptor }}",
                            "operation": "isNotEmpty"
                        }
                    ]
                }
            },
            "id": "if-is-b2b",
            "name": "¿Es para un tercero?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                450,
                300
            ]
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "SELECT id FROM clientes WHERE token_b2b = '{{ $node[\"Webhook - Nueva Orden\"].json.body.token_receptor }}' LIMIT 1;"
            },
            "id": "mysql-find-receptor",
            "name": "Buscar dueño del Token",
            "type": "n8n-nodes-base.mySql",
            "typeVersion": 2,
            "position": [
                650,
                200
            ]
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "INSERT INTO ordenes_trabajo (id_cliente, id_emisor, id_receptor, nombre_emisor, nombre_archivo, precio_final, estado)\nVALUES (\n  CASE WHEN '{{ $node[\"Buscar dueño del Token\"].json.id }}' != '' THEN '{{ $node[\"Buscar dueño del Token\"].json.id }}' ELSE '{{ $node[\"Webhook - Nueva Orden\"].json.body.id_emisor }}' END,\n  '{{ $node[\"Webhook - Nueva Orden\"].json.body.id_emisor }}',\n  CASE WHEN '{{ $node[\"Buscar dueño del Token\"].json.id }}' != '' THEN '{{ $node[\"Buscar dueño del Token\"].json.id }}' ELSE '{{ $node[\"Webhook - Nueva Orden\"].json.body.id_emisor }}' END,\n  '{{ $node[\"Webhook - Nueva Orden\"].json.body.nombre_emisor }}',\n  '{{ $node[\"Webhook - Nueva Orden\"].json.body.nombre_archivo }}',\n  {{ $node[\"Webhook - Nueva Orden\"].json.body.precio_final }},\n  'Pendiente de pago por cliente'\n);"
            },
            "id": "mysql-create-b2b-order",
            "name": "Crear Orden B2B",
            "type": "n8n-nodes-base.mySql",
            "typeVersion": 2,
            "position": [
                850,
                200
            ]
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "{\"success\": true, \"message\": \"Orden enviada al cliente con éxito\"}"
            },
            "id": "respond-success",
            "name": "Responder - Éxito",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1,
            "position": [
                1050,
                200
            ]
        }
    ],
    "connections": {
        "Webhook - Nueva Orden": {
            "main": [
                [
                    {
                        "node": "¿Es para un tercero?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "¿Es para un tercero?": {
            "main": [
                [
                    {
                        "node": "Buscar dueño del Token",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "Crear Orden B2B",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Buscar dueño del Token": {
            "main": [
                [
                    {
                        "node": "Crear Orden B2B",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Crear Orden B2B": {
            "main": [
                [
                    {
                        "node": "Responder - Éxito",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}