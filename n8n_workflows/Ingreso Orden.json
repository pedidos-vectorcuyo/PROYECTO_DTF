        "query": "/* 1. Insertamos o actualizamos el cliente con los datos nuevos de la web */\nINSERT INTO clientes (\n    nombre_completo,\n    email,\n    telefono,\n    fecha_creacion,\n    activo\n) VALUES (\n    '{{ $('Code in JavaScript').item.json[\"cliente\"] }}',\n    '{{ $('Code in JavaScript').item.json[\"email\"] }}',\n    '{{ $('Code in JavaScript').item.json[\"telefono\"] }}',\n    DATE_SUB(NOW(), INTERVAL 3 HOUR),\n    1\n)\nON DUPLICATE KEY UPDATE\n    nombre_completo = VALUES(nombre_completo),\n    telefono = VALUES(telefono);\n\n/* 2. Recuperamos el ID y Telegram Chat ID */\nSELECT id, telegram_chat_id \nFROM clientes \nWHERE email = '{{ $('Code in JavaScript').item.json[\"email\"] }}';",
