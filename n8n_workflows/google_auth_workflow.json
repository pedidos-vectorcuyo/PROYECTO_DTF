      "webhookId": "google-auth-vectorcuyo"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://www.googleapis.com/oauth2/v2/userinfo",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.body.google_token }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-google-userinfo",
      "name": "Google UserInfo API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.email }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "if-valid-token",
      "name": "¿Token válido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, nombre_completo, email, telefono FROM clientes WHERE email = '{{ $json.email }}' LIMIT 1;"
      },
      "id": "mysql-find-user",
      "name": "Buscar usuario en DB",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2,
      "position": [
        900,
        200
      ],
      "credentials": {
        "mySql": {
          "id": "REEMPLAZAR_CON_ID_CREDENCIAL",
          "name": "MySQL VectorCuyo"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.id }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "if-user-exists",
      "name": "¿Usuario existe?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1120,
        200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO clientes (nombre_completo, email, password, google_id, imagen_perfil)\nVALUES (\n  '{{ $node[\"Google UserInfo API\"].json.name }}',\n  '{{ $node[\"Google UserInfo API\"].json.email }}',\n  'GOOGLE_AUTH_NO_PASSWORD',\n  '{{ $node[\"Google UserInfo API\"].json.id }}',\n  '{{ $node[\"Google UserInfo API\"].json.picture }}'\n)\nON DUPLICATE KEY UPDATE\n  google_id = VALUES(google_id),\n  imagen_perfil = VALUES(imagen_perfil);\n\nSELECT id, nombre_completo, email FROM clientes WHERE email = '{{ $node[\"Google UserInfo API\"].json.email }}' LIMIT 1;"
      },
      "id": "mysql-create-user",
      "name": "Crear usuario nuevo",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2,
      "position": [
        1340,
        300
      ],
      "credentials": {
        "mySql": {
          "id": "REEMPLAZAR_CON_ID_CREDENCIAL",
          "name": "MySQL VectorCuyo"
        }
      }
    },
    {
